; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "MEGAMUEBLES.J.F.J.F."
#define MyAppVersion "1.0.2"
#define MyAppPublisher "ANDREWLM Company"
#define MyAppExeName "main.exe"

[Setup]
AppId={{89567FEB-F4F4-4F21-B2B5-DF97CF58E7FA}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName=C:\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
OutputDir=C:\Users\lemaa\Desktop
OutputBaseFilename=Instalador_MegaMuebles_v1
SetupIconFile=C:\Users\lemaa\Desktop\MEGAMUEBLES_PROJECT\dist\main\_internal\logo.ico
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\Users\lemaa\Desktop\MEGAMUEBLES_PROJECT\dist\main\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\lemaa\Desktop\MEGAMUEBLES_PROJECT\dist\main\.env"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\lemaa\Desktop\MEGAMUEBLES_PROJECT\dist\main\logo.png"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\lemaa\Desktop\MEGAMUEBLES_PROJECT\dist\main\_internal\*"; DestDir: "{app}\_internal"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent